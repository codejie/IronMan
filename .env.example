# Local application endpoints. Keep these ports together to avoid collisions.
IRONMAN_FRONTEND_HOST=127.0.0.1
IRONMAN_FRONTEND_PORT=6100
IRONMAN_BACKEND_HOST=127.0.0.1
IRONMAN_BACKEND_PORT=6101
AKSHARE_PROVIDER_HOST=127.0.0.1
AKSHARE_PROVIDER_PORT=6102
AKSHARE_PROVIDER_AUTOSTART=true
AKSHARE_PROVIDER_TIMEOUT_MS=8000
CORS_ORIGINS=http://127.0.0.1:6100,http://localhost:6100

# Replace before running Docker Compose in any shared environment.
JWT_SECRET=replace-this-with-a-long-random-secret
IRONMAN_DATA_DIR=./data
