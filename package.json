{
  "name": "ironman",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "bun run --cwd backend build && bun run --cwd frontend build",
    "akshare:setup": "bun ./scripts/setup-akshare-provider.ts",
    "dev:akshare": "bun ./scripts/run-akshare-provider.ts",
    "dev:backend": "bun ./scripts/run-backend-with-akshare.ts",
    "start:backend": "bun ./scripts/run-backend-with-akshare.ts start",
    "dev:frontend": "bun run --cwd frontend dev",
    "dev:all": "bun ./scripts/run-all.ts",
    "start:all": "bun ./scripts/run-all.ts start",
    "stop:all": "bun ./scripts/stop-all.ts",
    "stop:all:force": "bun ./scripts/stop-all.ts -9",
    "service:build": "bun run build",
    "service:start": "bun ./scripts/service-start.ts",
    "service:stop": "bun ./scripts/service-stop.ts",
    "docker:build": "docker buildx build --platform linux/arm64 --load -t ironman:arm64 -f Dockerfile .",
    "docker:start": "docker compose up -d --no-build",
    "docker:stop": "docker compose down",
    "db:recover-master": "bun ./scripts/recover-master-database.ts",
    "lint": "bun run --cwd backend lint && bun run --cwd frontend lint",
    "test": "bun run --cwd backend test && bun run --cwd frontend test"
  }
}
